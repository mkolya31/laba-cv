{
  "name": "laba-cv",
  "version": "0.1.0",
  "private": true,
  "description": "Сайт-резюме под конкретную вакансию, разрабатываемый с OpenSpec",
  "scripts": {
    "openspec": "openspec",
    "spec:list": "openspec list",
    "spec:validate": "openspec validate --all --strict",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "preview": "node scripts/serve.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run build && npm test",
    "test:unit": "node --test tests/runtime.node.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "@kolyach/eslint-config": "^1.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
